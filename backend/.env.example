# Aero-Planer — backend (скопируйте в .env и заполните)
PORT=5000

# MySQL 8 — обязательно: сервер должен быть запущен на этом хосте/порту
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=aero_planer

# JWT — в production обязателен сильный секрет (≥32 символов), иначе API не стартует
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# URL фронтенда (production: https://your-domain.ru; локально: http://localhost:5173)
CORS_ORIGIN=

NODE_ENV=production

# Опционально: ключ CheckWX для приоритетного метео-источника
CHECKWX_API_KEY=
