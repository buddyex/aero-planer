# Относительный путь: в production Nginx проксирует /api на Node.
# Локально Vite proxy (vite.config.ts) тоже проксирует /api и /socket.io.
VITE_API_URL=/api

# Не задавайте в production — Socket.io подключится к origin страницы (за Nginx).
# Для отладки без proxy можно раскомментировать:
# VITE_WS_URL=http://localhost:5000
